@model List<RaceDay.Client.Models.RaceEventViewModel>
@{
    ViewData["Title"] = "Events";
}
<div class="py-4">
    <h1 class="page-title">RaceDay Events</h1>
    <p class="text-muted">Events are loaded from the RaceDay API.</p>
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning">@ViewBag.Error</div>
    }
    else if (Model.Count == 0)
    {
        <div class="alert alert-info">No events were returned by the API.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Type</th><th>Distance (km)</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Title</strong><br /><small class="text-muted">@item.Description</small></td>
                        <td>@item.EventDate.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@item.Location</td>
                        <td>@item.EventType</td>
                        <td>@(item.DistanceKM?.ToString("0.##") ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
